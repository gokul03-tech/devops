[Unit]
Description=PeerLearn Flask API
After=network.target

[Service]
Type=simple
User=peerlearn
Group=peerlearn
WorkingDirectory=/opt/peerlearn/backend
EnvironmentFile=/etc/peerlearn.env
ExecStart=/opt/peerlearn/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/peerlearn

[Install]
WantedBy=multi-user.target
